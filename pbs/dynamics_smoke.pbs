#!/bin/bash -l
#PBS -N hubbard4-smoke
#PBS -A QC_NA_Sim
#PBS -q debug
#PBS -l select=1:ncpus=128,place=scatter,walltime=00:20:00
#PBS -j oe
#PBS -r y
set -euo pipefail
cd /lcrc/project/QC_NA_Sim/architecture_comparison
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1
sha256sum -c build/dynamics_inputs.sha256
ldd build/hubbard_sector
for threads in 8 16 32 64; do
  /home/ac.otten/soft/mambaforge/envs/qb_gsee/bin/python python/large_dynamics.py \
    --patch 4x4 --algorithms benchmark --steps 2 --threads "$threads" --out results/dynamics_4x4/smoke
 done
