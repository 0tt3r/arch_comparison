    %192 = qlx.apply #qlx.action<t>(%191) : (!qlx.logical_qubit) -> !qlx.logical_qubit
    %193 = qlx.apply #qlx.action<h>(%192) : (!qlx.logical_qubit) -> !qlx.logical_qubit
    %194 = qlx.measure <Z> %193 : !qlx.logical_qubit -> i1
  }
}
