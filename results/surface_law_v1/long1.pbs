set -euo pipefail
cd /lcrc/project/QC_NA_Sim/architecture_comparison
exec > results/surface_law_v1/long1.log 2>&1
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1
PY=/home/ac.otten/soft/mambaforge/envs/stim/bin/python
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 5 --shots 500000 --rounds 500 --basis x --seed 202609240100 --group holdout
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 5 --shots 500000 --rounds 500 --basis z --seed 202609240101 --group holdout
