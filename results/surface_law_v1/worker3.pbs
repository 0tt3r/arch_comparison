#!/bin/bash -l
#PBS -A QC_NA_Sim
#PBS -q backfill
#PBS -N surf-law-3
#PBS -l select=1:ncpus=128
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -r y
set -euo pipefail
cd /lcrc/project/QC_NA_Sim/architecture_comparison
exec > results/surface_law_v1/worker3.log 2>&1
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1
PY=/home/ac.otten/soft/mambaforge/envs/stim/bin/python
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 9 --shots 500000 --rounds 90 --basis x --seed 202609233100 --group cases
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 9 --shots 500000 --rounds 90 --basis z --seed 202609233101 --group cases
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 9 --shots 500000 --rounds 180 --basis x --seed 202609233110 --group cases
"$PY" -u results/surface_law_v1/worker_snapshot.py sample --p 0.001 --distance 9 --shots 500000 --rounds 180 --basis z --seed 202609233111 --group cases
